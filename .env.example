POSTGRES_DB=guacamole_db
POSTGRES_USER=guacamole_user
POSTGRES_PASSWORD=altere_senha_forte
GUACAMOLE_HOSTNAME=segportal.aqne.jus.br
GUACD_HOSTNAME=guacd

# --- Autenticação local (requerida) ---
# Senhas são provisionadas via Secret/env (nunca em claro no repositório).
# GUACAMOLE_ADMIN_PASSWORD=<senha forte obrigatória>
# SEGPORTAL_LOCAL_USERS="admin:Administrador:admin:admin@aqne.jus.br"
# SEGPORTAL_LOCAL_PASSWORDS="<senha>"
# PORTAL_SESSION_SECRET=<chave forte obrigatória — sem ela o portal não inicia>
# SEGPORTAL_VNC_PASSWORD=<senha VNC obrigatória (browser)>
# VNC_PASSWORD=<mesma senha VNC> (para o serviço web-browser)
#
# --- MFA TOTP (2FA, opcional mas recomendado) ---
# Segredos por usuário em JSON (via Secret). Gere com: python -c "import pyotp;print(pyotp.random_base32())"
# SEGPORTAL_TOTP_SECRETS='{"admin": "JBSWY3DPEHPK3PXP"}'

# --- LDAP (opcional; false = somente usuários locais) ---
LDAP_ENABLED=false
LDAP_HOSTNAME=ldap.aqne.jus.br
LDAP_PORT=636
LDAP_ENCRYPTION_METHOD=ssl
LDAP_USER_BASE_DN=OU=Usuarios,DC=aqne,DC=jus,DC=br
LDAP_GROUP_BASE_DN=OU=Grupos,DC=aqne,DC=jus,DC=br
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_SEARCH_BIND_DN=CN=svc-segportal,OU=Servicos,DC=aqne,DC=jus,DC=br
LDAP_SEARCH_BIND_PASSWORD=altere_credencial
LDAP_USER_SEARCH_FILTER=(objectClass=user)
LDAP_GROUP_SEARCH_FILTER=(objectClass=group)
LDAP_MEMBER_ATTRIBUTE=member
LDAP_MAX_SEARCH_RESULTS=1000
LDAP_NETWORK_TIMEOUT=5000
LDAP_READ_TIMEOUT=30000
# Cadeia CA (PEM) montada no container — deixe vazio se não usar
LDAP_CA_CHAIN_FILE=/etc/guacamole/certs/ldap-ca-chain.pem
LDAP_SERVER_CERTIFICATE_FILE=
LDAP_TRUSTSTORE_FILE=/etc/guacamole/certs/ldap-truststore.jks
LDAP_TRUSTSTORE_PASSWORD=<defina a senha do truststore>

# --- MFA (opcional; requer LDAP em geral) ---
MFA_ENABLED=false
MFA_RADIUS_HOST=radius.aqne.jus.br
MFA_RADIUS_PORT=1812
MFA_RADIUS_SECRET=altere_shared_secret

EGRESS_PROXY_HOST=proxy-egress
EGRESS_PROXY_PORT=3128
SESSION_TIMEOUT_MINUTES=60

# --- Navegador HTML padrão (Firefox via VNC) ---
# Deve coincidir com o parâmetro password da conexão Guacamole (scripts/sql/004-default-browser.sql)
VNC_PASSWORD=<senha forte obrigatória — mesmo valor de SEGPORTAL_VNC_PASSWORD>
FF_OPEN_URL=https://www.aqne.jus.br

# --- Portal auth (dashboard arquivos AD + nuvem) — http://localhost:8090 ---
PORTAL_SESSION_SECRET=<chave forte obrigatória — gere com: openssl rand -hex 32>
GUACAMOLE_PUBLIC_URL=http://localhost:8080/guacamole

REGISTRY=registry.aqne.jus.br/segportal
IMAGE_TAG=latest
